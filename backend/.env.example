# Google Cloud (Vertex AI)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Optional: for local dev with API key instead of Vertex
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-google-ai-studio-api-key

# GCS bucket for uploads (optional). Leave unset for local dev to use in-memory storage (no GCP credentials needed).
# PITCHPILOT_GCS_BUCKET=pitchpilot-uploads

# Live API model. With API key: gemini-2.0-flash-live-preview-04-09. With Vertex: gemini-2.5-flash-native-audio-preview-12-2025
# DEMO_AGENT_MODEL=gemini-2.0-flash-live-preview-04-09

# Live API version. With API key we default to v1beta so Live models are found. Use v1alpha to match ADK default.
# PITCHPILOT_LIVE_API_VERSION=v1alpha
